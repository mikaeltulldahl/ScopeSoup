{
  "type": "object",
  "additionalProperties": false,
  "required": ["done", "summary"],
  "properties": {
    "done": { "type": "boolean" },
    "summary": { "type": "string" },
    "mergedAs": { "type": "string" },
    "decisions": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["question", "chosen", "others", "why"],
      "properties": { "question": { "type": "string" }, "chosen": { "type": "string" }, "others": { "type": "array", "items": { "type": "string" } }, "why": { "type": "string" } }
    } },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["question", "options", "recommendation"],
      "properties": {
        "question": { "type": "string" },
        "options": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "description"],
          "properties": { "label": { "type": "string" }, "description": { "type": "string" } }
        } },
        "recommendation": { "type": "string" },
        "context": { "type": "string" }
      }
    }
  }
}
