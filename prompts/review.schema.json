{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "drafts": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["title", "description", "verification"],
      "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "verification": { "type": "string" } }
    } },
    "verdict": { "enum": ["approve", "changes"] },
    "findings": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["severity", "text"],
      "properties": { "severity": { "enum": ["must", "should"] }, "file": { "type": "string" }, "text": { "type": "string" }, "ask": { "type": "boolean" } }
    } }
  }
}
